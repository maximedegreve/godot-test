// Phase 5 textured terrain surface for the isolated 3D hex world prototype.
//
// The mesh geometry stays canonical: this shader never moves a vertex. It only
// interprets the per-vertex channels the mesher writes.
//
//   COLOR.rgb : blended biome / diagnostic colour resolved on the CPU
//   COLOR.a   : canonical organic(0)-to-mineral(1) floor material response,
//               `HexTerrainMesher.biome_material_response`, blended at shared
//               corners exactly like COLOR.rgb. Only the `biome` view writes a
//               varying value here; every diagnostic mode leaves the implicit
//               opaque 1.0 every authored `Color(...)` literal already carries,
//               so it never has to be special-cased back to flat.
//   UV.x      : coast factor, 0 at the waterline rising to 1 fully inland
//   UV.y      : surface kind, -0.5 seabed, 0 top face, 0.55 shore skirt,
//               1 cliff wall
//   UV2.x     : normalised elevation
//   UV2.y     : exposed-rock factor
//
// `diagnostic_blend` returns the flat authored colour so every debug view keeps
// the palette it is validated against. All procedural and textured detail is
// distance aware: the high-frequency band fades out as the camera pulls back
// so the strategy view never shimmers.
//
// Two small original seamless textures supply the floor's painterly material
// variation and subtle relief instead of one texture per biome:
//
//   material_pattern_texture (RGB8) - R mineral break-up, G organic break-up,
//     B a shared fine-grain multiplier. `COLOR.a` blends R against G, so the
//     same compact texture reads as sand/rock/clay in mineral biomes and as
//     moss/loam/litter in organic ones.
//   material_relief_texture (RGB8) - RG an object-space XZ bump gradient for a
//     subtle relief, B a paired roughness-variance height. Applied to the top
//     surface only; cliff walls keep their existing procedural strata
//     banding. The mesh carries no TANGENT/BINORMAL channel (deliberately, to
//     avoid a costly extra per-vertex attribute for a subtle effect), so the
//     bump is applied as a small additive perturbation of the existing
//     geometric NORMAL (carried into view space via `MODEL_NORMAL_MATRIX`
//     and `VIEW_MATRIX`), not the `NORMAL_MAP` built-in.
//
// Both are generated by the committed, deterministic
// `tools/generate_terrain_material_assets.gd` (see
// `docs/art-provenance/biome-floor-materials.md`) and sampled in world space
// with a `pattern_offset`/`pattern_rotation` derived from the world seed
// (`HexTerrainMaterial.seed_pattern_transform`) so the pattern does not swim
// as the world scrolls and different seeds do not share an obvious phase.
// That derivation is a pure hash, never an RNG-stream draw, so it cannot
// affect or be affected by generation signatures.
//
// Biome-floor blend field (fragment-space biome colour/response)
// ----------------------------------------------------------------
// `COLOR.rgb`/`COLOR.a` are resolved on the CPU per triangle-fan vertex
// (`HexTerrainMesher`), so their *value* is continuous across a shared
// corner but their *gradient* is an independent, arbitrary ramp inside every
// fan triangle -- at a sharp biome boundary this reads as hard triangular
// colour "wedges" radiating from each tile centre, not a smooth transition.
// `biome_field_texture` is a small per-world lookup texture
// (`HexTerrainBiomeField`, RGB biome colour / A material response) indexed
// by continuous fractional axial coordinates computed from `world_position`
// (mirroring `HexCoordinates.world_to_axial_fractional`) and sampled with a
// bounded triangular (simplex) interpolation over its three true
// hex-adjacent lattice texels -- plain bilinear would blend the *two*
// diagonal corners of an axial UV cell, which are two hex steps apart, not
// one, producing a visible diamond-shaped seam. This field-based sample
// replaces `base`/`material_response` for the flat top surface of the
// `biome` view only; every diagnostic view and every cliff/skirt wall keeps
// reading the original vertex `COLOR`/`COLOR.a` exactly as before.

shader_type spatial;
render_mode cull_back, diffuse_burley, specular_schlick_ggx;

uniform float diagnostic_blend : hint_range(0.0, 1.0) = 0.0;
uniform float high_contrast : hint_range(0.0, 1.0) = 0.0;
uniform float detail_strength : hint_range(0.0, 2.0) = 1.0;
uniform float camera_height = 70.0;
uniform float detail_near_height = 34.0;
uniform float detail_far_height = 160.0;
uniform float macro_scale = 0.24;
uniform float grain_scale = 1.7;
uniform vec3 sand_color : source_color = vec3(0.72, 0.63, 0.42);
uniform vec3 wet_sand_color : source_color = vec3(0.47, 0.42, 0.31);
uniform vec3 rock_color : source_color = vec3(0.44, 0.42, 0.40);
uniform vec3 snow_color : source_color = vec3(0.91, 0.93, 0.95);
uniform sampler2D material_pattern_texture : filter_linear_mipmap, repeat_enable;
uniform sampler2D material_relief_texture : filter_linear_mipmap, repeat_enable;
uniform sampler2D seabed_albedo_texture : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D seabed_normal_texture : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D seabed_roughness_texture : hint_default_white, filter_linear_mipmap_anisotropic, repeat_enable;
uniform float seabed_texture_scale = 0.12;
uniform vec2 pattern_offset = vec2(0.0, 0.0);
uniform float pattern_rotation = 0.0;
// One small RGBA8 texel per axial hex tile (`HexTerrainBiomeField`), built
// and bound once per world (`HexTerrainMaterial.bind_biome_field`), never
// per chunk or per frame. `filter_nearest` because sampling here is manual
// (triangular/simplex, not the driver's bilinear), and `repeat_disable`
// because the field is a bounded lookup table, not a tiling pattern.
uniform sampler2D biome_field_texture : filter_nearest, repeat_disable;
// (origin_q, 0.0): the axial column the field's pixel column 0 represents.
// Row 0 always represents axial row 0 (`HexWorldData` never pads rows).
uniform vec2 biome_field_origin = vec2(0.0, 0.0);
// (width, height) of `biome_field_texture`, in texels.
uniform vec2 biome_field_size = vec2(1.0, 1.0);
// World-space size of one hex tile (`HexWorldData.hex_size`), needed to
// invert `HexCoordinates.axial_to_world` back to fractional axial space.
uniform float hex_size = 1.0;

varying vec3 world_position;

const float SQRT_THREE = 1.7320508075688772;

float hash21(vec2 point) {
	vec2 value = fract(point * vec2(123.34, 345.45));
	value += dot(value, value + 34.345);
	return fract(value.x * value.y);
}

float value_noise(vec2 point) {
	vec2 cell = floor(point);
	vec2 offset = fract(point);
	offset = offset * offset * (3.0 - 2.0 * offset);
	float a = hash21(cell);
	float b = hash21(cell + vec2(1.0, 0.0));
	float c = hash21(cell + vec2(0.0, 1.0));
	float d = hash21(cell + vec2(1.0, 1.0));
	return mix(mix(a, b, offset.x), mix(c, d, offset.x), offset.y);
}

float fbm(vec2 point) {
	float total = 0.0;
	float amplitude = 0.5;
	for (int octave = 0; octave < 3; octave++) {
		total += amplitude * value_noise(point);
		point *= 2.03;
		amplitude *= 0.5;
	}
	return total;
}

// World-space UV for the two packed material textures: rotated and offset by
// the seed-derived, render-only transform so the pattern's phase differs
// between worlds without ever moving with the geometry itself.
vec2 pattern_uv(vec2 world_xz, float scale) {
	float c = cos(pattern_rotation);
	float s = sin(pattern_rotation);
	vec2 rotated = vec2(
		world_xz.x * c - world_xz.y * s,
		world_xz.x * s + world_xz.y * c
	);
	return rotated * scale + pattern_offset;
}

// Continuous (unrounded) axial coordinates for a world-space XZ position.
// Exact fragment-shader mirror of `HexCoordinates.world_to_axial_fractional`
// (see that function and the parity test in `tests/run_tests.gd`); this is
// the pre-rounding value, so it varies smoothly across a tile instead of
// jumping at the tile boundary the way `HexCoordinates.world_to_axial`'s
// rounded result would.
vec2 biome_field_axial_fractional(vec3 world_pos) {
	float safe_hex_size = max(hex_size, 0.0001);
	float fractional_q = (SQRT_THREE / 3.0 * world_pos.x - world_pos.z / 3.0) / safe_hex_size;
	float fractional_r = (2.0 / 3.0 * world_pos.z) / safe_hex_size;
	return vec2(fractional_q, fractional_r);
}

// Texel-centre UV for one integer (column, row) cell of `biome_field_texture`,
// clamped to the field's valid range: every field pixel already holds a
// valid colour (`HexTerrainBiomeField` flood-fills water/out-of-range cells
// from the nearest land tile), so clamping at the map edge reads that edge's
// real colour again rather than an undefined/black texel.
vec2 biome_field_texel_uv(vec2 texel) {
	vec2 clamped = clamp(texel, vec2(0.0), biome_field_size - vec2(1.0));
	return (clamped + vec2(0.5)) / biome_field_size;
}

// Bounded, analytic triangular (simplex) interpolation across the axial
// lattice. Naive bilinear filtering of an axial (q, r) grid is not valid for
// a hex lattice: the two UV-cell corners it blends along the diagonal,
// (i, j) and (i + 1, j + 1), are two hex steps apart (cube distance 2), not
// adjacent, so bilinear sampling reads a "diamond"-shaped seam of colour
// bleeding between non-neighbouring hexes along that diagonal. The lattice's
// *other* diagonal, (i + 1, j) to (i, j + 1), is a true hex-adjacent pair
// (cube distance 1, matching `HexCoordinates.DIRECTIONS`'s (-1, 1)/(1, -1)
// entries): splitting each unit cell along that short diagonal into two
// triangles, and blending only the three true neighbours of whichever
// triangle the fragment falls in, samples only real hex adjacency and stays
// exactly continuous across every triangle edge (the two triangles agree
// exactly where `fraction.x + fraction.y == 1.0`, verified algebraically and
// covered by a dedicated continuity test). Written branchlessly (both
// triangles' corner texels are always fetched and blended with a `step()`
// selector) to match this shader's existing mix/step-only style and avoid
// any dynamic-branching concern around implicit texture-derivative rules on
// mobile GPUs; the field is tiny and `filter_nearest`, so the extra fixed
// texel fetch is negligible.
vec4 sample_biome_field(vec3 world_pos) {
	vec2 fractional_axial = biome_field_axial_fractional(world_pos);
	vec2 field_position = fractional_axial - biome_field_origin;
	vec2 cell = floor(field_position);
	vec2 fraction = field_position - cell;
	vec4 c00 = texture(biome_field_texture, biome_field_texel_uv(cell));
	vec4 c10 = texture(biome_field_texture, biome_field_texel_uv(cell + vec2(1.0, 0.0)));
	vec4 c01 = texture(biome_field_texture, biome_field_texel_uv(cell + vec2(0.0, 1.0)));
	vec4 c11 = texture(biome_field_texture, biome_field_texel_uv(cell + vec2(1.0, 1.0)));
	float in_triangle_b = step(1.0, fraction.x + fraction.y);
	float w_far_a = max(1.0 - fraction.x - fraction.y, 0.0);
	float w_far_b = max(fraction.x + fraction.y - 1.0, 0.0);
	float w10 = mix(fraction.x, 1.0 - fraction.y, in_triangle_b);
	float w01 = mix(fraction.y, 1.0 - fraction.x, in_triangle_b);
	return c00 * w_far_a + c10 * w10 + c01 * w01 + c11 * w_far_b;
}

void vertex() {
	world_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	float detail_fade = 1.0 - clamp(
		(camera_height - detail_near_height)
			/ max(detail_far_height - detail_near_height, 0.001),
		0.0,
		1.0
	);
	detail_fade = mix(0.16, 1.0, detail_fade) * detail_strength;

	vec3 base = COLOR.rgb;
	float material_response = COLOR.a;
	float coast = UV.x;
	float kind = UV.y;
	float seabed = 1.0 - step(-0.25, kind);
	float wall = step(0.25, kind);
	float rock_face = smoothstep(0.6, 0.95, kind);
	float elevation = UV2.x;
	float rock = UV2.y;

	// Replace the per-vertex fan colour/response with the continuous field
	// sample, but only for the flat top surface (`wall == 0`, i.e. neither
	// shore skirt nor cliff wall) of the textured `biome` view
	// (`diagnostic_blend == 0`). Every diagnostic view and every cliff/skirt
	// wall keeps reading `COLOR`/`COLOR.a` exactly as before, so diagnostic
	// palettes stay byte-for-byte unchanged and cliff/coast-shelf geometry
	// and material are untouched.
	float use_biome_field = (
		(1.0 - wall)
		* (1.0 - seabed)
		* (1.0 - diagnostic_blend)
	);
	vec4 biome_field_sample = sample_biome_field(world_position);
	base = mix(base, biome_field_sample.rgb, use_biome_field);
	material_response = mix(material_response, biome_field_sample.a, use_biome_field);
	// Locally exposed rock nudges the floor reading further toward the
	// mineral end of the continuum even inside an organic biome, without a
	// second per-biome table.
	float mineral = clamp(material_response + rock * (1.0 - wall) * 0.4, 0.0, 1.0);

	vec2 macro_uv = pattern_uv(world_position.xz, macro_scale);
	vec2 grain_uv = pattern_uv(world_position.xz, grain_scale) + vec2(11.3, 4.7);
	vec4 macro_sample = texture(material_pattern_texture, macro_uv);
	vec4 grain_sample = texture(material_pattern_texture, grain_uv);
	vec4 relief_sample = texture(material_relief_texture, grain_uv);
	vec2 seabed_uv = pattern_uv(world_position.xz, seabed_texture_scale);
	vec3 seabed_albedo = texture(seabed_albedo_texture, seabed_uv).rgb;
	vec3 seabed_normal = texture(seabed_normal_texture, seabed_uv).rgb;
	float seabed_roughness = texture(seabed_roughness_texture, seabed_uv).r;
	float macro = mix(macro_sample.g, macro_sample.r, mineral);
	// The pattern texture's blue channel is a shared fine-grain multiplier
	// (see `HexTerrainMaterialPattern`), sampled at the finer `grain_scale`
	// so it reads as small painterly break-up rather than a second biome
	// axis: both mineral and organic floors use it identically.
	float grain = grain_sample.b;
	float strata = fbm(vec2(
		world_position.x * 0.85 + world_position.z * 0.55,
		world_position.y * 4.6
	));

	vec3 albedo = base;
	albedo *= mix(1.0, 0.84 + 0.34 * macro, 0.9);
	albedo *= mix(1.0, 0.85 + 0.29 * grain, detail_fade);

	// Exposed rock and scree on dry, high, thinly vegetated ground.
	albedo = mix(albedo, rock_color * (0.72 + 0.5 * macro), rock * 0.34 * (1.0 - wall));
	albedo = mix(
		albedo,
		mix(albedo, snow_color, 0.4),
		smoothstep(0.78, 1.0, elevation) * rock * (1.0 - wall)
	);

	// Coastal band: a narrow strip of dry sand inland of the waterline and wet
	// sand on the shore skirt itself. Deliberately narrow, because the coastal
	// biome colour is already sand and a wide band flattens the whole
	// shoreline.
	float beach = (1.0 - smoothstep(0.0, 0.32, coast))
		* (1.0 - rock_face)
		* (1.0 - seabed)
		* (1.0 - smoothstep(0.22, 0.55, elevation));
	albedo = mix(albedo, sand_color * (0.88 + 0.22 * grain), beach * 0.42);
	albedo = mix(albedo, wet_sand_color, beach * wall * 0.6);

	// Cliff walls read as layered rock rather than as darkened grass.
	albedo = mix(albedo, rock_color * (0.58 + 0.52 * strata), rock_face * 0.82);
	// The imported ground material gives the visible seabed authored mineral
	// breakup while the broad water tone keeps it integrated with the ocean's
	// depth absorption instead of reading as dry ground below glass.
	vec3 submerged_ground = mix(base * 0.72, seabed_albedo * vec3(0.58, 0.74, 0.69), 0.58);
	albedo = mix(albedo, submerged_ground, seabed * (1.0 - diagnostic_blend));

	vec3 final_albedo = mix(albedo, base, diagnostic_blend);
	float luma = dot(final_albedo, vec3(0.2126, 0.7152, 0.0722));
	final_albedo = mix(
		final_albedo,
		clamp((final_albedo - vec3(luma)) * 1.32 + vec3(luma * 1.08), vec3(0.0), vec3(1.0)),
		high_contrast
	);

	ALBEDO = final_albedo;
	float surface_roughness = (
		mix(0.95, 0.66, rock_face)
			- 0.06 * grain * detail_fade
			+ 0.05 * (relief_sample.b - 0.5) * detail_fade * (1.0 - wall)
	);
	surface_roughness = mix(
		surface_roughness,
		0.72 + seabed_roughness * 0.24,
		seabed * (1.0 - diagnostic_blend)
	);
	ROUGHNESS = mix(
		surface_roughness,
		0.92,
		diagnostic_blend
	);
	SPECULAR = mix(0.24, 0.5, diagnostic_blend);
	AO = mix(
		1.0,
		0.9 + 0.14 * macro,
		detail_fade * 0.5 * (1.0 - diagnostic_blend) * (1.0 - seabed)
	);
	AO_LIGHT_AFFECT = 0.3;
	// A subtle floor-only bump, added to the existing geometric normal rather
	// than replacing it via the `NORMAL_MAP` built-in (which needs a
	// TANGENT/BINORMAL the mesh does not carry). `NORMAL` in fragment() is in
	// view space, so the object-space bump is carried there through
	// `MODEL_NORMAL_MATRIX` (object -> world) then `VIEW_MATRIX` (world ->
	// view), both ordinary fragment built-ins. The perturbation collapses to
	// zero for every diagnostic view, on cliff walls, and fades out with
	// distance, so it can never shimmer at strategy zoom or leak into a flat
	// diagnostic render.
	vec3 object_bump = vec3(relief_sample.r * 2.0 - 1.0, 0.0, relief_sample.g * 2.0 - 1.0);
	vec3 seabed_bump = vec3(
		seabed_normal.r * 2.0 - 1.0,
		0.0,
		seabed_normal.g * 2.0 - 1.0
	);
	float bump_strength = (
		mix(0.35, 0.0, diagnostic_blend)
		* detail_fade
		* (1.0 - wall)
		* (1.0 - seabed)
	);
	vec3 view_bump = mat3(VIEW_MATRIX) * (MODEL_NORMAL_MATRIX * object_bump);
	vec3 view_seabed_bump = mat3(VIEW_MATRIX) * (MODEL_NORMAL_MATRIX * seabed_bump);
	NORMAL = normalize(
		NORMAL
		+ view_bump * bump_strength
		+ view_seabed_bump * seabed * (1.0 - diagnostic_blend) * 0.18
	);
}
